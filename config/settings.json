{
  "allowed_openai_params": [
    "thinking",
    "context_management"
  ],
  "enabledPlugins": {
    "superpowers@superpowers-dev": true
  },
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "PROXY_MANAGED",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:15721",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "agnes-2.0-flash",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "agnes-2.0-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "agnes-2.0-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "agnes-2.0-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "agnes-2.0-flash"
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "repo": "forrestchang/andrej-karpathy-skills",
        "source": "github"
      }
    },
    "superpowers-dev": {
      "source": {
        "path": "@@CLAUDE_DIR@@/plugins/superpowers",
        "source": "directory"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "nohup claudefy push --quiet >/dev/null 2>&1 &",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "claudefy pull --quiet",
            "type": "command"
          }
        ]
      }
    ]
  },
  "litellm_settings": {
    "drop_parmas": true
  },
  "model": "deepseek-v4-flash",
  "theme": "dark"
}